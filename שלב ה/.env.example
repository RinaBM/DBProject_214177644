# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tripdb
DB_USER=postgres
DB_PASSWORD=postgres

# Optional table overrides. Usually you do not need these.
# The server auto-detects both the original SmartRoute tables and the integrated partner tables:
# route/routes/tour, site/sites/station, guide, users/customer, guidedtour/tourinstance,
# booking/bookings, routesite/tourstation, payment_log, tour_price_history.
# DB_TABLE_ROUTES=route
# DB_TABLE_SITES=site
# DB_TABLE_GUIDES=guide
# DB_TABLE_USERS=users
# DB_TABLE_TOURS=guidedtour
# DB_TABLE_BOOKINGS=booking
# DB_TABLE_ROUTE_SITES=routesite

# Phase D PL/pgSQL routines from your GitHub files.
DB_FUNCTION_1=fn_available_places
DB_FUNCTION_2=fn_customer_unpaid_bookings
DB_PROCEDURE_1=pr_create_booking
DB_PROCEDURE_2=pr_pay_customer_bookings

PORT=3000
